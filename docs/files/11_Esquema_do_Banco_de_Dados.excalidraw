   "text": "id                     PK\nnome                   texto\nemailInstitucional     texto\nsenha                  texto (hash)\nmatricula              texto\ncurso                  texto\nperiodo                int\nturno                  int\ndataCadastro           data\nlinkCalendario         texto\nadministrador          bool\npreferencia {\n  tema                 int\n  tamanhoFonte         int\n  densidade            int\n  idioma               texto\n  visibilidadePerfil   int\n  mostrarOnline        bool\n  acessibilidade { altoContraste,\n    reduzirAnimacoes, leitorTela,\n    atalhosTeclado, focoReforcado }  bool\n  verificacaoDuasEtapas bool\n}\npreferenciasNotificacao[] {\n  tipoNotificacao      int\n  noAplicativo         bool\n  porEmail             bool\n}",
